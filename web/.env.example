# Copy to .env.local for local development.
# These are also set in the Render Static Site dashboard for production.

# Supabase project URL (same as the API service)
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Supabase ANON public key — Project Settings > API > anon public key.
# NOT the service role key. The anon key is safe in the browser bundle
# because RLS gates access; service_role bypasses RLS and would be a leak.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# FastAPI base URL — same Render service we already have.
VITE_API_BASE_URL=https://semco-ai-kb.onrender.com
