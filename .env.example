# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.

# Supabase project URL — Project Settings > API > Project URL
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase service role key — Project Settings > API > service_role (NOT anon)
# Required because RLS is enabled and only the service role has full access.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...

# Optional — direct Postgres connection string for raw psycopg2 use.
# Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=

# Optional — Render REST API token for deploys/log queries.
RENDER_API_KEY=
